// "Бид хоёр" — олон хос бүртгүүлдэг хувилбар.
// Хос бүрийн өгөгдөл `coupleId`-аар тусгаарлагдана (src/lib/db.ts → scoped()).
// Бүх мөрийн `by` талбар нь "a" эсвэл "b" — хосын аль нь үүсгэснийг заана.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Couple {
  id           String    @id @default(cuid())
  handle       String    @unique // хосын нэр — нэвтрэх, урилгын холбоосонд (жишээ: bat-saraa)
  nameA        String
  nameB        String
  startDate    DateTime? // зөвхөн огноо (UTC шөнө дунд)
  nextMeet     DateTime?
  cityA        String? // JSON: { name, tz, lat, lon }
  cityB        String?
  bg           String? // арын градиент: "#rrggbb,#rrggbb" (null = энгийн цаас)
  passwordHash String
  vaultPinHash String? // "Нууц өрөө"-ний тусдаа PIN (null = тохируулаагүй)
  // Өгөгдөл өөрчлөгдөх бүрт нэмэгдэнэ — нөгөө талын браузер шинэчлэгдэх дохио
  version      Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notes       Note[]
  letters     Letter[]
  memories    Memory[]
  bucket      BucketItem[]
  moments     Moment[]
  vaultPhotos VaultPhoto[]
  vaultWishes VaultWish[]
  avatars     AvatarImage[]
  days        SpecialDay[]
  lists       ListItem[]
  nudges      Nudge[]
  dateIdeas   DateIdea[]
  dateLogs    DateLog[]
  syncTimers  SyncTimer[]
  qotd        QotdAnswer[]
  gameAnswers GameAnswer[]
  quiz        QuizQuestion[]
  songs       Song[]
  pushSubs    PushSubscription[]
}

// "Our taste" — хамтын playlist (YouTube)
model Song {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  videoId   String
  title     String
  author    String   @default("")
  note      String   @default("") // яагаад энэ дууг нэмсэн бэ
  likedA    Boolean  @default(false)
  likedB    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([coupleId, videoId])
}

// Утасны push мэдэгдэл — төхөөрөмж бүрийн бүртгэл (who = тэр төхөөрөмж дээр нэвтэрсэн хүн)
model PushSubscription {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  who       String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([coupleId, who])
}

model Note {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  text      String
  color     String   @default("pink")
  likedA    Boolean  @default(false)
  likedB    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([coupleId])
}

// "Нээх захидал" — хүлээн авагч нээх хүртэл битүүмжлэгдэнэ
model Letter {
  id        String    @id @default(cuid())
  coupleId  String
  couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  title     String
  body      String
  openedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([coupleId])
}

model Memory {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  title     String
  date      DateTime // зөвхөн огноо
  place     String   @default("")
  story     String   @default("")
  photos    Photo[]
  createdAt DateTime @default(now())

  @@index([coupleId])
}

// Дурсамжийн зураг — хос нь Memory-оор дамжин тодорхойлогдоно
model Photo {
  id       String @id @default(cuid())
  memoryId String
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  mime     String
  data     Bytes

  @@index([memoryId])
}

model BucketItem {
  id        String    @id @default(cuid())
  coupleId  String
  couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  text      String
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([coupleId])
}

// "Өдрийн мөч" — хүн бүр өдөрт нэг зураг + сэтгэл + тайлбар
model Moment {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  day       String // YYYY-MM-DD, оруулсан хүний цагаар
  mood      String
  caption   String   @default("")
  filter    String   @default("none")
  mime      String? // зураггүй бол null
  photo     Bytes?
  thumb     Bytes? // хуанлид зориулсан жижиг хувилбар
  reaction  String? // хайртынх нь үлдээсэн эможи
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coupleId, by, day])
  @@index([coupleId, day])
}

// ── Нууц өрөө (18+) — зөвхөн тусдаа PIN-ээр нээгдэнэ, нөөц файлд орохгүй ──

model VaultPhoto {
  id        String    @id @default(cuid())
  coupleId  String
  couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  caption   String    @default("")
  mime      String
  data      Bytes
  thumb     Bytes
  viewOnce  Boolean   @default(false) // хайрт нь нэг үзмэгц устна
  viewedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([coupleId])
}

// "Хүслийн тохирол" — item = WISHES-ийн дугаар, answer: 2 тийм, 1 магадгүй, 0 үгүй
model VaultWish {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  item      Int
  answer    Int
  createdAt DateTime @default(now())

  @@unique([coupleId, item, by])
}

// Профайл зураг (who = "a" | "b")
model AvatarImage {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  who       String
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt

  @@unique([coupleId, who])
}

model SpecialDay {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  title     String
  date      DateTime // зөвхөн огноо
  emoji     String   @default("📌")
  yearly    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([coupleId])
}

model ListItem {
  id        String    @id @default(cuid())
  coupleId  String
  couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  type      String
  title     String
  url       String    @default("")
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([coupleId])
}

model Nudge {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  createdAt DateTime @default(now())

  @@index([coupleId, createdAt])
}

model DateIdea {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  emoji     String   @default("💡")
  text      String
  createdAt DateTime @default(now())

  @@index([coupleId])
}

model DateLog {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  text      String
  emoji     String   @default("💞")
  createdAt DateTime @default(now())

  @@index([coupleId])
}

// Кино, дуугаа зэрэг асаах тоолуур
model SyncTimer {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  at        DateTime
  createdAt DateTime @default(now())

  @@index([coupleId])
}

model QotdAnswer {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  day       String
  question  String   @default("") // асуултын сан өөрчлөгдсөн ч түүх зөв харагдана
  text      String
  createdAt DateTime @default(now())

  @@unique([coupleId, day, by])
}

// "Аль нь дээр вэ?" ба "Хэн нь илүү?" тоглоомын хариулт (q = асуултын дугаар)
model GameAnswer {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  game      String
  q         Int
  choice    Int
  createdAt DateTime @default(now())

  @@unique([coupleId, game, q, by])
}

// "Намайг хэр мэдэх вэ?" — өөрийнхөө тухай асуулт, хайрт нь таана
model QuizQuestion {
  id        String    @id @default(cuid())
  coupleId  String
  couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  by        String
  question  String
  answer    String
  guess     String?
  correct   Boolean?
  guessedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([coupleId])
}
