# SQLite өгөгдлийн сангийн зам (төслийн үндсэн хавтаснаас)
DATABASE_URL="file:./prisma/dev.db"

# Нэвтрэх cookie-г гарын үсэглэх нууц түлхүүр — дараах командаар үүсгэнэ:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Push мэдэгдэл (VAPID) — дараах командаар үүсгэнэ:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Сонголттой: VAPID_SUBJECT="https://таны-домэйн"
